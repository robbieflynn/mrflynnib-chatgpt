# Public destinations
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TEACHABLE_LOGIN_URL=
NEXT_PUBLIC_TEACHABLE_AA_HL_URL=
NEXT_PUBLIC_TEACHABLE_AA_SL_URL=
NEXT_PUBLIC_TEACHABLE_AI_HL_URL=
NEXT_PUBLIC_TEACHABLE_AI_SL_URL=
NEXT_PUBLIC_BOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/mrflynnib

# Transactional school-enquiry notifications
# Use a sending-only Resend key restricted to mrflynnib.com.
RESEND_API_KEY=
SCHOOL_ENQUIRY_FROM_EMAIL=Mr Flynn IB Website <website@mrflynnib.com>
SCHOOL_ENQUIRY_TO_EMAIL=contact@mrflynnib.com
TEACHER_APPLICATION_TO_EMAIL=mrflynnib@gmail.com

# Optional storage for contact and tutoring enquiries
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Student accounts and question-bank syncing
# Use the Project URL and public Publishable key from Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ziina custom checkout (server-side only; never prefix secrets with NEXT_PUBLIC_)
# Keep ZIINA_TEST_MODE=true until a complete test order, entitlement and payout review passes.
ZIINA_ACCESS_TOKEN=
ZIINA_WEBHOOK_SECRET=
ZIINA_TEST_MODE=true
ZIINA_ALLOW_TEST_ENTITLEMENTS=false
ZIINA_WEBHOOK_ENFORCE_IP=true
