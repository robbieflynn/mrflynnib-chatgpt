{
  "name": "mrflynnib-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build:course-platform": "node scripts/generate-course-video-access.mjs && node scripts/build-course-platform.mjs && node scripts/validate-past-paper-data.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "generate:assignment-configs": "WRITE_ASSIGNMENT_CONFIGS=1 node scripts/audit-assignment-choices.mjs",
    "question-bank:optimize": "node scripts/optimize-question-bank-delivery.mjs && node scripts/verify-question-bank-delivery.mjs",
    "question-bank:verify": "node scripts/verify-question-bank-delivery.mjs",
    "audit:assignment-choices": "node scripts/audit-assignment-choices.mjs",
    "audit:past-papers": "node scripts/validate-past-paper-data.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "import:teachable-access": "node scripts/import-teachable-access.mjs",
    "test:smoke": "node scripts/smoke-platform.mjs",
    "test:load": "node scripts/smoke-platform.mjs --load",
    "captions": "node scripts/manage-video-captions.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "exceljs": "^4.4.0",
    "katex": "^0.18.1",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
